{
  "name": "dsh-next-hint",
  "version": "0.1.2",
  "private": false,
  "description": "DeepSeek Harness plugin that proposes the next prompt in the composer once a turn settles.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoshenming/dsh-next-hint.git"
  },
  "homepage": "https://github.com/xiaoshenming/dsh-next-hint#readme",
  "bugs": {
    "url": "https://github.com/xiaoshenming/dsh-next-hint/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "composer",
    "suggestion",
    "prompt",
    "web-ui"
  ],
  "exports": {
    ".": "./plugin/index.mjs",
    "./client": "./plugin/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin",
    "src",
    "docs",
    "skills",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch"
  }
}
